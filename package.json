{
  "name": "nks-bob-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "MILJO=local vp dev",
    "dev:server": "pnpm run --filter server dev",
    "dev": "pnpm run \"/^dev:(frontend|server)$/\"",
    "localnais:frontend": "MILJO=localnais vp dev --host",
    "localnais:server": "MILJO=localnais pnpm run --filter server dev",
    "localnais": "pnpm run \"/^localnais:(frontend|server)$/\"",
    "build:frontend": "tsc -b && vp build",
    "build:server": "pnpm run --filter server build",
    "build": "pnpm run \"/^build:(frontend|server)$/\"",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "preview": "vp preview",
    "format": "vp fmt \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "preinstall": "npx only-allow pnpm",
    "prepare": "vp config"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.17.2",
    "@navikt/ds-css": "^8.17.2",
    "@navikt/ds-react": "^8.17.2",
    "@navikt/ds-tailwind": "^8.17.2",
    "@unhead/react": "^3.4.2",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "mdast-util-find-and-replace": "^3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "swr": "^2.5.1",
    "ts-debounce": "^5.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
